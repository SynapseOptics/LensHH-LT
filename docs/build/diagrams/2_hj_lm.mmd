---
config:
  theme: base
  flowchart:
    curve: basis
    nodeSpacing: 46
    rankSpacing: 50
    padding: 8
  themeVariables:
    fontFamily: "Segoe UI, Helvetica, Arial, sans-serif"
    fontSize: 15px
    lineColor: "#8a8a8a"
---
flowchart TD
    Enter(["Trial entry &middot; perturbed start x0"]) --> Eval0["evaluate merit M(x0)<br/>the GPU pre-screen scores<br/>thousands of x0 at once here"]
    Eval0 --> HJDec{"run HJ?"}
    HJDec -- yes --> HJ
    HJDec -- no --> LM

    subgraph HJ["Hooke-Jeeves &middot; pattern search"]
      direction TB
      H1["step h = h0"] --> H2{"HJ budget left?"}
      H2 -- yes --> H3["exploratory move<br/>try +/- h on each variable"]
      H3 --> H4{"improved?"}
      H4 -- yes --> H5["pattern move &middot; extrapolate"]
      H4 -- no --> H6["shrink h to h/2"]
      H5 --> H2
      H6 --> H2
      H2 -- no --> HJExit["HJ done"]
    end
    HJ --> LM

    subgraph LM["Levenberg-Marquardt"]
      direction TB
      L1["Jacobian J &middot; analytic or FD"] --> L2["solve (JT J + lambda I) d = JT R"]
      L2 --> L3["try x = x + d"]
      L3 --> L4{"merit improved?"}
      L4 -- yes --> L5["accept step<br/>lambda = lambda / 10"]
      L4 -- no --> L6["reject step<br/>lambda = lambda x10"]
      L5 --> L7{"converged or<br/>budget spent?"}
      L6 --> L7
      L7 -- no --> L1
      L7 -- yes --> LMExit["LM done"]
    end
    LM --> Return(["Return final merit"])

    classDef term  fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px,color:#14311b
    classDef dec   fill:#fff8e1,stroke:#f6a821,stroke-width:1.5px,color:#4a3610
    classDef work  fill:#f5f5f5,stroke:#adadad,stroke-width:1.5px,color:#2a2a2a
    classDef gpu   fill:#ede7f6,stroke:#5e35b1,stroke-width:2.5px,color:#2e1065
    class Enter,Return term
    class HJDec,H2,H4,L4,L7 dec
    class H1,H3,H5,H6,HJExit,L1,L2,L3,L5,L6,LMExit work
    class Eval0 gpu
