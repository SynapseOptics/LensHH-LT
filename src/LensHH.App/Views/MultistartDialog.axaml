<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LensHH.App.ViewModels"
        xmlns:controls="using:LensHH.App.Views.Controls"
        x:Class="LensHH.App.Views.MultistartDialog"
        x:DataType="vm:MultistartDialogViewModel"
        Title="Multi Start Optimization"
        Icon="avares://LensHH.App/Assets/icon_256.png"
        Width="1050" Height="700"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        MinWidth="980" MinHeight="550">

  <DockPanel Margin="12">

    <!-- ═══ Bottom Buttons ═══ -->
    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto"
          Margin="0,6,0,0">
      <Button Grid.Column="0" Content="Start" Command="{Binding StartOptimizationCommand}"
              IsEnabled="{Binding !IsRunning}" Width="90" Margin="0,0,8,0"
              Tag="Begin the multistart run. Progress appears in the tables below; use Stop to cancel cleanly."
              PointerEntered="Help_PointerEntered" PointerExited="Help_PointerExited" />
      <Button Grid.Column="1" Content="Stop" Command="{Binding StopOptimizationCommand}"
              IsEnabled="{Binding IsRunning}" Width="90"
              Tag="Cancel the run. The design is restored to the best-ever values seen so far."
              PointerEntered="Help_PointerEntered" PointerExited="Help_PointerExited" />

      <controls:GpuStatusChip Grid.Column="2" HorizontalAlignment="Left"
                              Margin="14,0,0,0" VerticalAlignment="Center" />

      <Button Grid.Column="3" Content="Preview" IsEnabled="{Binding !IsRunning}" Click="Preview_Click" Width="90" Margin="0,0,8,0"
              Tag="Show which merit/Jacobian engine this run will actually use, and why — before starting it."
              PointerEntered="Help_PointerEntered" PointerExited="Help_PointerExited" />
      <Button Grid.Column="4" Content="OK — Accept Results" Click="OK_Click" Width="180"
              IsEnabled="{Binding IsComplete}" FontWeight="SemiBold" Margin="0,0,8,0" />
      <Button Grid.Column="5" Content="Cancel — Revert" Click="Cancel_Click" Width="150" IsCancel="True" />
    </Grid>

    <!-- ═══ Help / description strip ═══ -->
    <Border DockPanel.Dock="Bottom" Background="#F5F5F0" BorderBrush="#CCC"
            BorderThickness="1" CornerRadius="3" Padding="8,4" Margin="0,6,0,0">
      <TextBlock Text="{Binding HelpText}" FontSize="11" Foreground="#333"
                 TextWrapping="Wrap" MinHeight="28" />
    </Border>

    <!-- GPU acceleration settings live in Editors ▸ Preferences (global, 3 modes). -->

    <!-- ═══ Advanced (collapsed by default) — Engine / Derivative / LM knobs ═══ -->
    <Expander DockPanel.Dock="Top" Header="▸ Advanced (engine, derivative, LM internals)"
              IsExpanded="False" Margin="0,0,0,6">
      <StackPanel Orientation="Vertical" Spacing="6" Margin="6,4,0,4">
        <StackPanel Orientation="Horizontal" Spacing="12">
          <TextBlock Text="Engine:" VerticalAlignment="Center" />
          <ComboBox Width="160" ItemsSource="{Binding EngineModeOptions}"
                    SelectedIndex="{Binding EngineModeIndex}" IsEnabled="{Binding !IsRunning}"
                    Tag="Which merit-function engine drives this run. C# is the legacy path; C++ (Native) routes evaluate_merit + Jacobian through the native engine — bit-equal in value, typically faster on Jacobian. Default since 1.0.115 is C++ Native for new merits."
                    PointerEntered="Help_PointerEntered" PointerExited="Help_PointerExited"
                    GotFocus="Help_GotFocus" LostFocus="Help_LostFocus" />
          <TextBlock Text="Derivative:" VerticalAlignment="Center" Margin="6,0,0,0" />
          <ComboBox Width="180" ItemsSource="{Binding DerivativeModeOptions}"
                    SelectedIndex="{Binding DerivativeModeIndex}"
                    IsEnabled="{Binding !IsRunning}"
                    Tag="C++ Jacobian mode (ignored when Engine = C#). Finite Difference perturbs each variable; Analytic uses templated Dual&lt;W&gt; forward-mode AD through the ray trace + operands. Analytic is bit-equal to FD on 134/134 bedrock tests except a documented 1.5% drift on multi-wave OPD Jacobians (does not affect merit values)."
                    PointerEntered="Help_PointerEntered" PointerExited="Help_PointerExited"
                    GotFocus="Help_GotFocus" LostFocus="Help_LostFocus" />
        </StackPanel>
        <!-- Per-trial Hooke-Jeeves knobs (moved here 2026-08-20 to declutter the main panel). The
             SEED HJ is now automatic for constrained designs; these only affect the OPTIONAL per-trial HJ. -->
        <StackPanel Orientation="Horizontal" Spacing="12">
          <TextBlock Text="HJ Steps:" VerticalAlignment="Center" />
          <TextBox Width="60" Text="{Binding HjStepsPerTrial, UpdateSourceTrigger=LostFocus}" IsEnabled="{Binding !IsRunning}"
                   Tag="Hooke-Jeeves probe steps used by the OPTIONAL 'Physical HJ per trial' pass (to its right). HJ doesn't use Jacobians, so it can cross merit discontinuities (vignetting, ray-trace failures) where LM stalls. Only used when 'Physical HJ per trial' is on. Default 10."
                   PointerEntered="Help_PointerEntered" PointerExited="Help_PointerExited"
                   GotFocus="Help_GotFocus" LostFocus="Help_LostFocus" />
          <CheckBox Content="Physical HJ per trial (constrained)"
                    IsChecked="{Binding PhysicalTrialHj}" IsEnabled="{Binding !IsRunning}" VerticalAlignment="Center" Margin="12,0,0,0"
                    Tag="ADVANCED, rarely needed. The SEED is already polished automatically for constrained designs (a physical Hooke-Jeeves pass, like BH's hop-0). This adds a physical HJ pre-step on EVERY trial before its LM — only helps if the per-trial random restarts keep landing pinned against bounds. COSTS TIME per trial; leave OFF unless trials are visibly stalling on a bounded design."
                    PointerEntered="Help_PointerEntered" PointerExited="Help_PointerExited"
                    GotFocus="Help_GotFocus" LostFocus="Help_LostFocus" />
        </StackPanel>
        <TextBlock Text="Defaults reflect the engine bedrock as of 1.0.115. Most users do not need to change these."
                   FontSize="10" Foreground="#777" FontStyle="Italic" />
      </StackPanel>
    </Expander>

    <!-- ═══ Settings ═══ -->
    <Border DockPanel.Dock="Top" BorderBrush="#CCC" BorderThickness="1"
            CornerRadius="4" Padding="10,6" Margin="0,0,0,6">
      <Grid ColumnDefinitions="Auto,6,70,16,Auto,6,60,16,Auto,6,60,16,Auto,6,70,16,Auto,6,60,*"
            RowDefinitions="Auto,6,Auto,6,Auto,6,Auto,6,Auto">
        <!-- Row 0 -->
        <TextBlock Grid.Row="0" Grid.Column="0" Text="Trials:" VerticalAlignment="Center" />
        <TextBox Grid.Row="0" Grid.Column="2" Text="{Binding MaxTrials, UpdateSourceTrigger=LostFocus}" IsEnabled="{Binding !IsRunning}"
                 Tag="Maximum number of randomization trials. Each trial perturbs the design, runs a short LM, and keeps the result only if the merit improves. More trials = better chance of escaping local minima."
                 PointerEntered="Help_PointerEntered" PointerExited="Help_PointerExited"
                 GotFocus="Help_GotFocus" LostFocus="Help_LostFocus" />

        <TextBlock Grid.Row="0" Grid.Column="4" Text="LM/Trial:" VerticalAlignment="Center" />
        <TextBox Grid.Row="0" Grid.Column="6" Text="{Binding LmIterationsPerTrial, UpdateSourceTrigger=LostFocus}" IsEnabled="{Binding !IsRunning}"
                 Tag="Maximum Levenberg–Marquardt iterations run after each randomization. Deeper local refinement per trial, at the cost of slower overall throughput."
                 PointerEntered="Help_PointerEntered" PointerExited="Help_PointerExited"
                 GotFocus="Help_GotFocus" LostFocus="Help_LostFocus" />

        <TextBlock Grid.Row="0" Grid.Column="8" Text="Init LM:" VerticalAlignment="Center" />
        <TextBox Grid.Row="0" Grid.Column="10" Text="{Binding InitialLmIterations, UpdateSourceTrigger=LostFocus}"
                 IsEnabled="{Binding InitialLmInputEnabled}"
                 Tag="Iterations for the one-time LM pass run on the starting design before any randomization. Establishes the baseline merit all trials are compared against. Set this small (or check Skip Init LM at right) when the seed is already converged — Phase 1 LM can't escape the basin that Phase 2 is randomizing out of."
                 PointerEntered="Help_PointerEntered" PointerExited="Help_PointerExited"
                 GotFocus="Help_GotFocus" LostFocus="Help_LostFocus" />

        <TextBlock Grid.Row="0" Grid.Column="12" Text="Init Sigma:" VerticalAlignment="Center" />
        <TextBox Grid.Row="0" Grid.Column="14" Text="{Binding InitialSigma, UpdateSourceTrigger=LostFocus}" IsEnabled="{Binding !IsRunning}"
                 Tag="Starting/reset perturbation sigma. The search starts here and returns here on every accepted improvement. On rejection sigma GROWS (×1.5) up to Sigma Cap to climb out of the basin; any acceptance snaps it back to this small start. Default 0.001."
                 PointerEntered="Help_PointerEntered" PointerExited="Help_PointerExited"
                 GotFocus="Help_GotFocus" LostFocus="Help_LostFocus" />

        <TextBlock Grid.Row="0" Grid.Column="16" Text="Sigma Cap:" VerticalAlignment="Center" />
        <TextBox Grid.Row="0" Grid.Column="18" Text="{Binding SigmaCap, UpdateSourceTrigger=LostFocus}" IsEnabled="{Binding !IsRunning}"
                 Tag="Upper bound on the perturbation sigma — the largest kick the escape phase will reach. On a rejection streak sigma grows ×1.5 per rejection up to this cap. Higher = wider exploration when refinement stalls; lower = stays nearer the current design. Default 0.1."
                 PointerEntered="Help_PointerEntered" PointerExited="Help_PointerExited"
                 GotFocus="Help_GotFocus" LostFocus="Help_LostFocus" />

        <!-- Row 1 -->
        <TextBlock Grid.Row="2" Grid.Column="0" Text="Glass Sub %:" VerticalAlignment="Center" />
        <TextBox Grid.Row="2" Grid.Column="2" Text="{Binding GlassSubstitutionProbability, UpdateSourceTrigger=LostFocus}" IsEnabled="{Binding !IsRunning}"
                 Tag="Per-trial probability (%) that an eligible surface's glass is swapped for a random one from its assigned catalog. Eligibility comes from Optimization → Glass Substitution Settings. 0 = disabled."
                 PointerEntered="Help_PointerEntered" PointerExited="Help_PointerExited"
                 GotFocus="Help_GotFocus" LostFocus="Help_LostFocus" />

        <CheckBox Grid.Row="2" Grid.Column="4" Grid.ColumnSpan="3" Content="Constrained Only"
                  IsChecked="{Binding ConstrainedOnly}" IsEnabled="{Binding !IsRunning}" VerticalAlignment="Center"
                  Tag="Restrict randomization to variables that have at least one bound (min, max, or both). Variables with no bounds at all are frozen at their current value between trials."
                  PointerEntered="Help_PointerEntered" PointerExited="Help_PointerExited"
                  GotFocus="Help_GotFocus" LostFocus="Help_LostFocus" />

        <CheckBox Grid.Row="2" Grid.Column="8" Grid.ColumnSpan="3" Content="Broyden Update"
                  IsChecked="{Binding UseBroydenUpdate}" IsEnabled="{Binding !IsRunning}" VerticalAlignment="Center"
                  Tag="Inside each trial's LM, update the Jacobian using cheap Broyden rank-1 updates between full finite-difference refreshes. Usually faster; turn off for very ill-conditioned problems."
                  PointerEntered="Help_PointerEntered" PointerExited="Help_PointerExited"
                  GotFocus="Help_GotFocus" LostFocus="Help_LostFocus" />

        <CheckBox Grid.Row="4" Grid.Column="4" Grid.ColumnSpan="3" Content="Skip Init LM"
                  IsChecked="{Binding SkipInitialLm}" IsEnabled="{Binding !IsRunning}" VerticalAlignment="Center"
                  Tag="Skip the one-time Phase 1 LM pass before randomization. Recommended when the seed design is already at a local minimum: Phase 1 LM can't escape the basin that Phase 2 is trying to randomize out of, so it's pure cost. When unchecked, Phase 1 uses the Init LM iteration cap above."
                  PointerEntered="Help_PointerEntered" PointerExited="Help_PointerExited"
                  GotFocus="Help_GotFocus" LostFocus="Help_LostFocus" />

        <CheckBox Grid.Row="2" Grid.Column="12" Grid.ColumnSpan="3" Content="Metropolis Acceptance"
                  IsChecked="{Binding EnableMetropolis}" IsEnabled="{Binding !IsRunning}" VerticalAlignment="Center"
                  Tag="When on, the optimizer keeps a 'currentCenter' state separate from 'best' and may occasionally accept a worse-than-best basin as the new center with probability exp(-dM/T), letting it walk out of basins it has already mined. Best is always updated by strict improvement only — the returned design is monotone. Temperature autotunes from the first 10 |dM| samples."
                  PointerEntered="Help_PointerEntered" PointerExited="Help_PointerExited"
                  GotFocus="Help_GotFocus" LostFocus="Help_LostFocus" />

        <!-- HJ Steps moved to Advanced 2026-08-20 (it only drives the optional per-trial HJ). -->

        <!-- Row 4: LM tunables -->
        <TextBlock Grid.Row="4" Grid.Column="0" Text="Init Damp:" VerticalAlignment="Center" />
        <TextBox Grid.Row="4" Grid.Column="2" Text="{Binding InitialDamping, UpdateSourceTrigger=LostFocus}" IsEnabled="{Binding !IsRunning}"
                 Tag="Levenberg–Marquardt initial damping. 1e-3 (default) is the across-the-board default — robust on aspheric mixes and well-conditioned problems alike. Drop to 1e-6 for gauss-newton-like behavior on very smooth, well-scaled designs; raise to 1e-2 if the optimizer keeps rejecting steps early."
                 PointerEntered="Help_PointerEntered" PointerExited="Help_PointerExited"
                 GotFocus="Help_GotFocus" LostFocus="Help_LostFocus" />

        <!-- Seed — reproducible runs for studying settings (1.0.147). -->
        <TextBlock Grid.Row="4" Grid.Column="16" Text="Seed:" VerticalAlignment="Center" />
        <TextBox Grid.Row="4" Grid.Column="18" Text="{Binding Seed, UpdateSourceTrigger=LostFocus}" IsEnabled="{Binding !IsRunning}"
                 Tag="RNG seed. The same seed with the same settings reproduces a run bit-for-bit — ideal for studying how one setting changes the result. Change it (1, 2, 3, …) for a genuinely independent run."
                 PointerEntered="Help_PointerEntered" PointerExited="Help_PointerExited"
                 GotFocus="Help_GotFocus" LostFocus="Help_LostFocus" />

        <!-- Init HJ control removed 2026-08-20: the seed Hooke-Jeeves pre-polish now runs AUTOMATICALLY
             for constrained designs (any bounded variable), mirroring BH's hop-0. See
             MultistartOptimizer.AutoSeedHjSteps. InitialHjSteps remains a CLI/advanced override. -->

        <CheckBox Grid.Row="4" Grid.Column="8" Grid.ColumnSpan="5" Content="Rescale on Glass Swap"
                  IsChecked="{Binding RescaleOnGlassSwap}" IsEnabled="{Binding !IsRunning}" VerticalAlignment="Center"
                  Tag="Experimental: when a glass is swapped, rescale that element's curvatures by (n_old-1)/(n_new-1) so its optical power is preserved to first order. Keeps the swapped design feasible instead of broken, which improves the typical (median) result. Validated to help Multistart; off by default."
                  PointerEntered="Help_PointerEntered" PointerExited="Help_PointerExited"
                  GotFocus="Help_GotFocus" LostFocus="Help_LostFocus" />

        <!-- Row 8: local-step method -->
        <TextBlock Grid.Row="8" Grid.Column="0" Text="LM Step:" VerticalAlignment="Center" />
        <ComboBox Grid.Row="8" Grid.Column="2" Grid.ColumnSpan="5" HorizontalAlignment="Stretch"
                  ItemsSource="{Binding StepOptions}" SelectedItem="{Binding SelectedStep}"
                  IsEnabled="{Binding !IsRunning}" VerticalAlignment="Center"
                  Tag="Diagonal added to the Gauss-Newton matrix inside each trial LM. LM uses one scalar damping for every variable. PSD (Dilworth pseudo-second-derivative) instead estimates each variable&apos;s own curvature by differencing successive Jacobians, which converges deeper on designs with many variables; PSD III is the stronger variant. Selecting PSD turns Broyden off, because PSD needs successive FRESH Jacobians - you can re-enable it if you want."
                  PointerEntered="Help_PointerEntered" PointerExited="Help_PointerExited"
                  GotFocus="Help_GotFocus" LostFocus="Help_LostFocus" />

        <StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="13" Orientation="Horizontal" Spacing="24">
          <CheckBox Content="Reduced-dim perturbation"
                    IsChecked="{Binding ReducedDimPerturbation}" IsEnabled="{Binding !IsRunning}" VerticalAlignment="Center"
                    Tag="On by default. The plain perturbation kicks EVERY variable each trial; a full-dimension jump is usually yanked straight back to the nearest basin by LM. With this on, a fraction of trials perturb only a random SUBSET of the variables (leaving the rest at center), so the search can move along low-dimensional manifolds into ADJACENT, deeper basins a full-dim kick overshoots. Turn off for a specific design if needed."
                    PointerEntered="Help_PointerEntered" PointerExited="Help_PointerExited"
                    GotFocus="Help_GotFocus" LostFocus="Help_LostFocus" />
          <CheckBox Content="Basin memory / diverse restart"
                    IsChecked="{Binding BasinMemoryRestart}" IsEnabled="{Binding !IsRunning}" VerticalAlignment="Center"
                    Tag="On by default. The plain walk is a SINGLE chain anchored to one best; once sigma saturates at the cap it keeps flailing around that same best. With this on, the run keeps an archive of the distinct minima it has visited and, after stalling at the cap, RESTARTS the walk from a fresh point FAR from every archived basin — with randomized glasses — mapping new regions instead of circling one minimum. The run-wide best is tracked separately and never lost. Turn off for a specific design if needed."
                    PointerEntered="Help_PointerEntered" PointerExited="Help_PointerExited"
                    GotFocus="Help_GotFocus" LostFocus="Help_LostFocus" />
          <!-- Physical HJ per trial moved to the Advanced expander 2026-08-20 (rarely needed; the seed
               HJ is automatic). -->
        </StackPanel>
      </Grid>
    </Border>

    <!-- ═══ Status Bar ═══ -->
    <Border DockPanel.Dock="Top" Background="#F5F5F5" CornerRadius="4"
            Padding="12,6" Margin="0,0,0,6">
      <Grid ColumnDefinitions="*,Auto,20,Auto,20,Auto" RowDefinitions="Auto,4,Auto">
        <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding StatusText}"
                   FontWeight="SemiBold" FontSize="14" />
        <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding ElapsedText}" FontSize="13" />
        <TextBlock Grid.Row="0" Grid.Column="5"
                   Text="{Binding TrialsAccepted, StringFormat='Accepted: {0}'}" FontSize="13" />

        <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding MeritText}"
                   FontSize="13" FontFamily="Consolas" />
        <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="5"
                    Orientation="Horizontal" Spacing="16">
          <TextBlock Text="{Binding InitialMeritText, StringFormat='Initial: {0}'}"
                     FontSize="12" Foreground="Gray" />
          <TextBlock Text="{Binding PostLmMeritText, StringFormat='Post-LM: {0}'}"
                     FontSize="12" Foreground="Gray" />
          <TextBlock Text="{Binding CurrentMeritText, StringFormat='Current: {0}'}"
                     FontSize="12" Foreground="#888" />
          <TextBlock Text="{Binding BestMeritText, StringFormat='Best: {0}'}"
                     FontSize="12" Foreground="Green" FontWeight="SemiBold" />
          <TextBlock Text="{Binding EngineText}"
                     FontSize="12" Foreground="Gray" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- ═══ Tables: Variables + Glasses side by side ═══ -->
    <Grid ColumnDefinitions="*,8,Auto">

      <!-- Variable table -->
      <DataGrid Grid.Column="0" ItemsSource="{Binding VariableRows}"
                AutoGenerateColumns="False" CanUserSortColumns="False"
                GridLinesVisibility="All" IsReadOnly="True"
                FontSize="13" FontFamily="Consolas">
        <DataGrid.Styles>
          <Style Selector="DataGridColumnHeader">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="FontFamily" Value="Segoe UI" />
          </Style>
        </DataGrid.Styles>
        <DataGrid.Columns>
          <DataGridTextColumn Header="Variable" Binding="{Binding Description}" Width="160" />
          <DataGridTextColumn Header="Start" Binding="{Binding StartValue}" Width="130" />
          <DataGridTextColumn Header="Best" Binding="{Binding CurrentValue}" Width="130" />
          <DataGridTextColumn Header="Delta" Binding="{Binding Delta}" Width="120" />
        </DataGrid.Columns>
      </DataGrid>

      <!-- Glass table -->
      <DataGrid Grid.Column="2" ItemsSource="{Binding GlassRows}"
                AutoGenerateColumns="False" CanUserSortColumns="False"
                GridLinesVisibility="All" IsReadOnly="True"
                FontSize="13" MinWidth="240">
        <DataGrid.Styles>
          <Style Selector="DataGridColumnHeader">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="6,4" />
          </Style>
        </DataGrid.Styles>
        <DataGrid.Columns>
          <DataGridTextColumn Header="Surface" Binding="{Binding SurfaceIndex}" Width="65" />
          <DataGridTextColumn Header="Start Glass" Binding="{Binding StartGlass}" Width="100" />
          <DataGridTextColumn Header="Best Glass" Binding="{Binding CurrentGlass}" Width="100" />
        </DataGrid.Columns>
      </DataGrid>
    </Grid>

  </DockPanel>
</Window>
