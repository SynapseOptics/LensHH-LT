<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LensHH.App.ViewModels"
        x:Class="LensHH.App.Views.SurfacePropertiesDialog"
        x:DataType="vm:SurfacePropertiesViewModel"
        Title="{Binding Title}"
        Icon="avares://LensHH.App/Assets/icon_256.png"
        Width="620" Height="760"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        MinWidth="550" MinHeight="560">

  <Window.Styles>
    <!-- Match the main-window content tabs (Lens Editor, 2D Layout, …): the Fluent default
         TabItem header font is oversized for this dialog. -->
    <Style Selector="TabItem">
      <Setter Property="FontSize" Value="13" />
    </Style>
  </Window.Styles>

  <DockPanel Margin="10">
    <!-- Buttons -->
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                HorizontalAlignment="Right" Spacing="8" Margin="0,10,0,0">
      <Button Content="OK" Click="OK_Click" Width="80" />
      <Button Content="Cancel" Click="Cancel_Click" Width="80" IsCancel="True" />
    </StackPanel>

    <TabControl>
      <!-- ═══ Variable / Pickup Tab ═══ -->
      <TabItem Header="Variable / Pickup">
        <ScrollViewer>
          <StackPanel Margin="12" Spacing="14">

            <!-- Curvature -->
            <Border BorderBrush="#CCC" BorderThickness="1" CornerRadius="4" Padding="12,8">
              <StackPanel Spacing="6">
                <TextBlock Text="Curvature (1/Radius)" FontWeight="SemiBold" FontSize="14" />
                <DockPanel>
                  <TextBlock Text="Value:" Width="70" VerticalAlignment="Center" />
                  <TextBox Text="{Binding Curvature, UpdateSourceTrigger=LostFocus}" Width="180" />
                </DockPanel>
                <StackPanel Orientation="Horizontal" Spacing="20">
                  <RadioButton Content="Fixed" IsChecked="{Binding CurvatureState.IsFixed}" GroupName="Curv" />
                  <RadioButton Content="Variable" IsChecked="{Binding CurvatureState.IsVariable}" GroupName="Curv" />
                  <RadioButton Content="Pickup" IsChecked="{Binding CurvatureState.IsPickupSelected}" GroupName="Curv" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8"
                            IsVisible="{Binding CurvatureState.IsPickup}">
                  <TextBlock Text="Source Surf:" VerticalAlignment="Center" />
                  <ComboBox ItemsSource="{Binding CurvatureState.AvailablePickupSurfaces}"
                            SelectedItem="{Binding CurvatureState.PickupSourceSurface}" Width="70" />
                  <TextBlock Text="Scale:" VerticalAlignment="Center" />
                  <TextBox Text="{Binding CurvatureState.PickupScale, UpdateSourceTrigger=LostFocus}" Width="70" />
                  <TextBlock Text="Offset:" VerticalAlignment="Center" />
                  <TextBox Text="{Binding CurvatureState.PickupOffset, UpdateSourceTrigger=LostFocus}" Width="70" />
                </StackPanel>
              </StackPanel>
            </Border>

            <!-- Thickness -->
            <Border BorderBrush="#CCC" BorderThickness="1" CornerRadius="4" Padding="12,8">
              <StackPanel Spacing="6">
                <TextBlock Text="Thickness" FontWeight="SemiBold" FontSize="14" />
                <DockPanel>
                  <TextBlock Text="Value:" Width="70" VerticalAlignment="Center" />
                  <TextBox Text="{Binding Thickness, UpdateSourceTrigger=LostFocus}" Width="180" />
                </DockPanel>
                <StackPanel Orientation="Horizontal" Spacing="20">
                  <RadioButton Content="Fixed" IsChecked="{Binding ThicknessState.IsFixed}" GroupName="Thick" />
                  <RadioButton Content="Variable" IsChecked="{Binding ThicknessState.IsVariable}" GroupName="Thick" />
                  <RadioButton Content="Pickup" IsChecked="{Binding ThicknessState.IsPickupSelected}" GroupName="Thick" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8"
                            IsVisible="{Binding ThicknessState.IsPickup}">
                  <TextBlock Text="Source Surf:" VerticalAlignment="Center" />
                  <ComboBox ItemsSource="{Binding ThicknessState.AvailablePickupSurfaces}"
                            SelectedItem="{Binding ThicknessState.PickupSourceSurface}" Width="70" />
                  <TextBlock Text="Scale:" VerticalAlignment="Center" />
                  <TextBox Text="{Binding ThicknessState.PickupScale, UpdateSourceTrigger=LostFocus}" Width="70" />
                  <TextBlock Text="Offset:" VerticalAlignment="Center" />
                  <TextBox Text="{Binding ThicknessState.PickupOffset, UpdateSourceTrigger=LostFocus}" Width="70" />
                </StackPanel>
              </StackPanel>
            </Border>

            <!-- Conic -->
            <Border BorderBrush="#CCC" BorderThickness="1" CornerRadius="4" Padding="12,8">
              <StackPanel Spacing="6">
                <TextBlock Text="Conic Constant" FontWeight="SemiBold" FontSize="14" />
                <DockPanel>
                  <TextBlock Text="Value:" Width="70" VerticalAlignment="Center" />
                  <TextBox Text="{Binding Conic, UpdateSourceTrigger=LostFocus}" Width="180" />
                </DockPanel>
                <StackPanel Orientation="Horizontal" Spacing="20">
                  <RadioButton Content="Fixed" IsChecked="{Binding ConicState.IsFixed}" GroupName="Conic" />
                  <RadioButton Content="Variable" IsChecked="{Binding ConicState.IsVariable}" GroupName="Conic" />
                  <RadioButton Content="Pickup" IsChecked="{Binding ConicState.IsPickupSelected}" GroupName="Conic" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8"
                            IsVisible="{Binding ConicState.IsPickup}">
                  <TextBlock Text="Source Surf:" VerticalAlignment="Center" />
                  <ComboBox ItemsSource="{Binding ConicState.AvailablePickupSurfaces}"
                            SelectedItem="{Binding ConicState.PickupSourceSurface}" Width="70" />
                  <TextBlock Text="Scale:" VerticalAlignment="Center" />
                  <TextBox Text="{Binding ConicState.PickupScale, UpdateSourceTrigger=LostFocus}" Width="70" />
                  <TextBlock Text="Offset:" VerticalAlignment="Center" />
                  <TextBox Text="{Binding ConicState.PickupOffset, UpdateSourceTrigger=LostFocus}" Width="70" />
                </StackPanel>
              </StackPanel>
            </Border>

            <!-- Aperture solve: Semi-Diameter when the aperture is Fixed, Clear Aperture % when Auto.
                 Only the group matching the surface's aperture mode is shown. -->
            <Border BorderBrush="#CCC" BorderThickness="1" CornerRadius="4" Padding="12,8"
                    IsVisible="{Binding IsFixedAperture}">
              <StackPanel Spacing="6">
                <TextBlock Text="Semi-Diameter (Fixed aperture)" FontWeight="SemiBold" FontSize="14" />
                <DockPanel>
                  <TextBlock Text="Value:" Width="70" VerticalAlignment="Center" />
                  <TextBox Text="{Binding SemiDiameterValue, UpdateSourceTrigger=LostFocus}" Width="180" />
                </DockPanel>
                <StackPanel Orientation="Horizontal" Spacing="20">
                  <RadioButton Content="Fixed" IsChecked="{Binding SemiDiameterState.IsFixed}" GroupName="SemiDia" />
                  <RadioButton Content="Variable" IsChecked="{Binding SemiDiameterState.IsVariable}"
                               IsEnabled="{Binding SemiDiameterState.CanVary}" GroupName="SemiDia" />
                  <RadioButton Content="Pickup" IsChecked="{Binding SemiDiameterState.IsPickupSelected}" GroupName="SemiDia" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8"
                            IsVisible="{Binding SemiDiameterState.IsPickup}">
                  <TextBlock Text="Source Surf:" VerticalAlignment="Center" />
                  <ComboBox ItemsSource="{Binding SemiDiameterState.AvailablePickupSurfaces}"
                            SelectedItem="{Binding SemiDiameterState.PickupSourceSurface}" Width="70" />
                  <TextBlock Text="Scale:" VerticalAlignment="Center" />
                  <TextBox Text="{Binding SemiDiameterState.PickupScale, UpdateSourceTrigger=LostFocus}" Width="70" />
                  <TextBlock Text="Offset:" VerticalAlignment="Center" />
                  <TextBox Text="{Binding SemiDiameterState.PickupOffset, UpdateSourceTrigger=LostFocus}" Width="70" />
                </StackPanel>
              </StackPanel>
            </Border>

            <Border BorderBrush="#CCC" BorderThickness="1" CornerRadius="4" Padding="12,8"
                    IsVisible="{Binding IsAutoAperture}">
              <StackPanel Spacing="6">
                <TextBlock Text="Clear Aperture % (Auto aperture)" FontWeight="SemiBold" FontSize="14" />
                <DockPanel>
                  <TextBlock Text="Value:" Width="70" VerticalAlignment="Center" />
                  <TextBox Text="{Binding ClearAperturePercentValue, UpdateSourceTrigger=LostFocus}" Width="180" />
                </DockPanel>
                <StackPanel Orientation="Horizontal" Spacing="20">
                  <RadioButton Content="Fixed" IsChecked="{Binding ClearApertureState.IsFixed}" GroupName="ClearAp" />
                  <RadioButton Content="Variable" IsChecked="{Binding ClearApertureState.IsVariable}"
                               IsEnabled="{Binding ClearApertureState.CanVary}" GroupName="ClearAp" />
                  <RadioButton Content="Pickup" IsChecked="{Binding ClearApertureState.IsPickupSelected}" GroupName="ClearAp" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8"
                            IsVisible="{Binding ClearApertureState.IsPickup}">
                  <TextBlock Text="Source Surf:" VerticalAlignment="Center" />
                  <ComboBox ItemsSource="{Binding ClearApertureState.AvailablePickupSurfaces}"
                            SelectedItem="{Binding ClearApertureState.PickupSourceSurface}" Width="70" />
                  <TextBlock Text="Scale:" VerticalAlignment="Center" />
                  <TextBox Text="{Binding ClearApertureState.PickupScale, UpdateSourceTrigger=LostFocus}" Width="70" />
                  <TextBlock Text="Offset:" VerticalAlignment="Center" />
                  <TextBox Text="{Binding ClearApertureState.PickupOffset, UpdateSourceTrigger=LostFocus}" Width="70" />
                </StackPanel>
              </StackPanel>
            </Border>

          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ═══ Aperture Tab ═══ -->
      <TabItem Header="Aperture">
        <StackPanel Margin="16" Spacing="14">
          <TextBlock Text="Surface aperture settings" FontStyle="Italic" Foreground="Gray" />
          <DockPanel>
            <TextBlock Text="Inner Radius:" Width="130" VerticalAlignment="Center" />
            <TextBox Text="{Binding InnerRadius}" Width="140" />
          </DockPanel>
          <DockPanel>
            <TextBlock Text="Obscuration Radius:" Width="130" VerticalAlignment="Center" />
            <TextBox Text="{Binding ObscurationRadius}" Width="140" />
          </DockPanel>
        </StackPanel>
      </TabItem>

      <!-- ═══ Even Asphere Tab ═══ -->
      <TabItem Header="Even Asphere" IsVisible="{Binding IsEvenAsphere}">
        <ScrollViewer>
          <StackPanel Margin="12" Spacing="4">
            <Grid ColumnDefinitions="90,200,70" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                  Margin="0,4">
              <TextBlock Grid.Row="0" Grid.Column="0" Text="Order" FontWeight="SemiBold" Margin="0,4" />
              <TextBlock Grid.Row="0" Grid.Column="1" Text="Coefficient" FontWeight="SemiBold" Margin="0,4" />
              <TextBlock Grid.Row="0" Grid.Column="2" Text="Variable" FontWeight="SemiBold" Margin="0,4" />

              <TextBlock Grid.Row="1" Grid.Column="0" Text="2nd" VerticalAlignment="Center" />
              <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding A2, UpdateSourceTrigger=LostFocus}" Margin="0,2" />
              <CheckBox Grid.Row="1" Grid.Column="2" IsChecked="{Binding A2Var}" HorizontalAlignment="Center" />

              <TextBlock Grid.Row="2" Grid.Column="0" Text="4th" VerticalAlignment="Center" />
              <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding A4, UpdateSourceTrigger=LostFocus}" Margin="0,2" />
              <CheckBox Grid.Row="2" Grid.Column="2" IsChecked="{Binding A4Var}" HorizontalAlignment="Center" />

              <TextBlock Grid.Row="3" Grid.Column="0" Text="6th" VerticalAlignment="Center" />
              <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding A6, UpdateSourceTrigger=LostFocus}" Margin="0,2" />
              <CheckBox Grid.Row="3" Grid.Column="2" IsChecked="{Binding A6Var}" HorizontalAlignment="Center" />

              <TextBlock Grid.Row="4" Grid.Column="0" Text="8th" VerticalAlignment="Center" />
              <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding A8, UpdateSourceTrigger=LostFocus}" Margin="0,2" />
              <CheckBox Grid.Row="4" Grid.Column="2" IsChecked="{Binding A8Var}" HorizontalAlignment="Center" />

              <TextBlock Grid.Row="5" Grid.Column="0" Text="10th" VerticalAlignment="Center" />
              <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding A10, UpdateSourceTrigger=LostFocus}" Margin="0,2" />
              <CheckBox Grid.Row="5" Grid.Column="2" IsChecked="{Binding A10Var}" HorizontalAlignment="Center" />

              <TextBlock Grid.Row="6" Grid.Column="0" Text="12th" VerticalAlignment="Center" />
              <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding A12, UpdateSourceTrigger=LostFocus}" Margin="0,2" />
              <CheckBox Grid.Row="6" Grid.Column="2" IsChecked="{Binding A12Var}" HorizontalAlignment="Center" />

              <TextBlock Grid.Row="7" Grid.Column="0" Text="14th" VerticalAlignment="Center" />
              <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding A14, UpdateSourceTrigger=LostFocus}" Margin="0,2" />
              <CheckBox Grid.Row="7" Grid.Column="2" IsChecked="{Binding A14Var}" HorizontalAlignment="Center" />

              <TextBlock Grid.Row="8" Grid.Column="0" Text="16th" VerticalAlignment="Center" />
              <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding A16, UpdateSourceTrigger=LostFocus}" Margin="0,2" />
              <CheckBox Grid.Row="8" Grid.Column="2" IsChecked="{Binding A16Var}" HorizontalAlignment="Center" />
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ═══ Glass Model Tab ═══ -->
      <TabItem Header="Glass Model">
        <ScrollViewer>
          <StackPanel Margin="12" Spacing="14">

            <Border BorderBrush="#CCC" BorderThickness="1" CornerRadius="4" Padding="12,8">
              <StackPanel Spacing="6">
                <CheckBox Content="Enable Model Index" IsChecked="{Binding ModelIndexEnabled}"
                          FontWeight="SemiBold" FontSize="14" />
                <TextBlock TextWrapping="Wrap" Foreground="Gray" FontSize="12"
                           Text="The refractive index is computed from Nd, Vd and dPgF instead of a catalog glass. Enabling loads these from the current glass; disabling snaps to the closest catalog glass." />
                <DockPanel>
                  <TextBlock Text="Glass:" Width="70" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding GlassDisplay}" VerticalAlignment="Center" FontWeight="SemiBold" />
                </DockPanel>
              </StackPanel>
            </Border>

            <!-- Nd -->
            <Border BorderBrush="#CCC" BorderThickness="1" CornerRadius="4" Padding="12,8"
                    IsEnabled="{Binding ModelIndexEnabled}">
              <StackPanel Spacing="6">
                <TextBlock Text="Nd (index at d-line)" FontWeight="SemiBold" FontSize="14" />
                <DockPanel>
                  <TextBlock Text="Value:" Width="70" VerticalAlignment="Center" />
                  <TextBox Text="{Binding ModelNdValue, UpdateSourceTrigger=LostFocus}" Width="180" />
                </DockPanel>
                <StackPanel Orientation="Horizontal" Spacing="20">
                  <RadioButton Content="Fixed" IsChecked="{Binding ModelNdState.IsFixed}" GroupName="ModelNd" />
                  <RadioButton Content="Variable" IsChecked="{Binding ModelNdState.IsVariable}" GroupName="ModelNd" />
                  <RadioButton Content="Pickup" IsChecked="{Binding ModelNdState.IsPickupSelected}" GroupName="ModelNd" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8"
                            IsVisible="{Binding ModelNdState.IsPickup}">
                  <TextBlock Text="Source Surf:" VerticalAlignment="Center" />
                  <ComboBox ItemsSource="{Binding ModelNdState.AvailablePickupSurfaces}"
                            SelectedItem="{Binding ModelNdState.PickupSourceSurface}" Width="70" />
                  <TextBlock Text="Scale:" VerticalAlignment="Center" />
                  <TextBox Text="{Binding ModelNdState.PickupScale, UpdateSourceTrigger=LostFocus}" Width="70" />
                  <TextBlock Text="Offset:" VerticalAlignment="Center" />
                  <TextBox Text="{Binding ModelNdState.PickupOffset, UpdateSourceTrigger=LostFocus}" Width="70" />
                </StackPanel>
              </StackPanel>
            </Border>

            <!-- Vd -->
            <Border BorderBrush="#CCC" BorderThickness="1" CornerRadius="4" Padding="12,8"
                    IsEnabled="{Binding ModelIndexEnabled}">
              <StackPanel Spacing="6">
                <TextBlock Text="Vd (Abbe number)" FontWeight="SemiBold" FontSize="14" />
                <DockPanel>
                  <TextBlock Text="Value:" Width="70" VerticalAlignment="Center" />
                  <TextBox Text="{Binding ModelVdValue, UpdateSourceTrigger=LostFocus}" Width="180" />
                </DockPanel>
                <StackPanel Orientation="Horizontal" Spacing="20">
                  <RadioButton Content="Fixed" IsChecked="{Binding ModelVdState.IsFixed}" GroupName="ModelVd" />
                  <RadioButton Content="Variable" IsChecked="{Binding ModelVdState.IsVariable}" GroupName="ModelVd" />
                  <RadioButton Content="Pickup" IsChecked="{Binding ModelVdState.IsPickupSelected}" GroupName="ModelVd" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8"
                            IsVisible="{Binding ModelVdState.IsPickup}">
                  <TextBlock Text="Source Surf:" VerticalAlignment="Center" />
                  <ComboBox ItemsSource="{Binding ModelVdState.AvailablePickupSurfaces}"
                            SelectedItem="{Binding ModelVdState.PickupSourceSurface}" Width="70" />
                  <TextBlock Text="Scale:" VerticalAlignment="Center" />
                  <TextBox Text="{Binding ModelVdState.PickupScale, UpdateSourceTrigger=LostFocus}" Width="70" />
                  <TextBlock Text="Offset:" VerticalAlignment="Center" />
                  <TextBox Text="{Binding ModelVdState.PickupOffset, UpdateSourceTrigger=LostFocus}" Width="70" />
                </StackPanel>
              </StackPanel>
            </Border>

            <!-- dPgF -->
            <Border BorderBrush="#CCC" BorderThickness="1" CornerRadius="4" Padding="12,8"
                    IsEnabled="{Binding ModelIndexEnabled}">
              <StackPanel Spacing="6">
                <TextBlock Text="dPgF (relative partial dispersion)" FontWeight="SemiBold" FontSize="14" />
                <DockPanel>
                  <TextBlock Text="Value:" Width="70" VerticalAlignment="Center" />
                  <TextBox Text="{Binding ModelDPgFValue, UpdateSourceTrigger=LostFocus}" Width="180" />
                </DockPanel>
                <StackPanel Orientation="Horizontal" Spacing="20">
                  <RadioButton Content="Fixed" IsChecked="{Binding ModelDPgFState.IsFixed}" GroupName="ModelDPgF" />
                  <RadioButton Content="Variable" IsChecked="{Binding ModelDPgFState.IsVariable}" GroupName="ModelDPgF" />
                  <RadioButton Content="Pickup" IsChecked="{Binding ModelDPgFState.IsPickupSelected}" GroupName="ModelDPgF" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8"
                            IsVisible="{Binding ModelDPgFState.IsPickup}">
                  <TextBlock Text="Source Surf:" VerticalAlignment="Center" />
                  <ComboBox ItemsSource="{Binding ModelDPgFState.AvailablePickupSurfaces}"
                            SelectedItem="{Binding ModelDPgFState.PickupSourceSurface}" Width="70" />
                  <TextBlock Text="Scale:" VerticalAlignment="Center" />
                  <TextBox Text="{Binding ModelDPgFState.PickupScale, UpdateSourceTrigger=LostFocus}" Width="70" />
                  <TextBlock Text="Offset:" VerticalAlignment="Center" />
                  <TextBox Text="{Binding ModelDPgFState.PickupOffset, UpdateSourceTrigger=LostFocus}" Width="70" />
                </StackPanel>
              </StackPanel>
            </Border>

          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ═══ Focal Length Tab (Paraxial ideal lens only) ═══ -->
      <TabItem Header="Focal Length" IsVisible="{Binding IsParaxial}">
        <ScrollViewer>
          <StackPanel Margin="12" Spacing="14">
            <Border BorderBrush="#CCC" BorderThickness="1" CornerRadius="4" Padding="12,8">
              <StackPanel Spacing="6">
                <TextBlock Text="Focal Length (ideal thin lens)" FontWeight="SemiBold" FontSize="14" />
                <DockPanel>
                  <TextBlock Text="f (mm):" Width="70" VerticalAlignment="Center" />
                  <TextBox Text="{Binding FocalLengthValue, UpdateSourceTrigger=LostFocus}" Width="180" />
                </DockPanel>
                <DockPanel>
                  <TextBlock Text="Power:" Width="70" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding FocalPowerText}" VerticalAlignment="Center" FontWeight="SemiBold" />
                </DockPanel>
                <TextBlock Text="The optimizer varies power (diopters), continuous through afocal; set its min/max in the Variable Editor."
                           TextWrapping="Wrap" FontSize="11" Foreground="#666" />
                <StackPanel Orientation="Horizontal" Spacing="20">
                  <RadioButton Content="Fixed" IsChecked="{Binding FocalLengthState.IsFixed}" GroupName="Focal" />
                  <RadioButton Content="Variable" IsChecked="{Binding FocalLengthState.IsVariable}" GroupName="Focal" />
                  <RadioButton Content="Pickup" IsChecked="{Binding FocalLengthState.IsPickupSelected}" GroupName="Focal" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8"
                            IsVisible="{Binding FocalLengthState.IsPickup}">
                  <TextBlock Text="Source Surf:" VerticalAlignment="Center" />
                  <ComboBox ItemsSource="{Binding FocalLengthState.AvailablePickupSurfaces}"
                            SelectedItem="{Binding FocalLengthState.PickupSourceSurface}" Width="70" />
                  <TextBlock Text="Scale:" VerticalAlignment="Center" />
                  <TextBox Text="{Binding FocalLengthState.PickupScale, UpdateSourceTrigger=LostFocus}" Width="70" />
                  <TextBlock Text="Offset:" VerticalAlignment="Center" />
                  <TextBox Text="{Binding FocalLengthState.PickupOffset, UpdateSourceTrigger=LostFocus}" Width="70" />
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ═══ Coordinate Break Tab (PRO surface type) ═══ -->
      <TabItem Header="Coordinate Break" IsVisible="{Binding IsCoordinateBreak}">
        <ScrollViewer>
          <StackPanel Margin="12" Spacing="12">
            <TextBlock Text="Coordinate Break — decenter and tilt of the local coordinate frame."
                       TextWrapping="Wrap" FontSize="12" Foreground="#666" />

            <!-- Order -->
            <Border BorderBrush="#CCC" BorderThickness="1" CornerRadius="4" Padding="12,8">
              <DockPanel>
                <TextBlock Text="Order:" Width="70" VerticalAlignment="Center" />
                <ComboBox SelectedIndex="{Binding OrderIndex}" Width="230">
                  <ComboBoxItem>Decenter then Tilt (0)</ComboBoxItem>
                  <ComboBoxItem>Tilt then Decenter (1)</ComboBoxItem>
                </ComboBox>
              </DockPanel>
            </Border>

            <!-- Decenter X -->
            <Border BorderBrush="#CCC" BorderThickness="1" CornerRadius="4" Padding="12,8">
              <StackPanel Spacing="6">
                <DockPanel>
                  <TextBlock Text="Decenter X (mm):" Width="130" VerticalAlignment="Center" />
                  <TextBox Text="{Binding DecenterXValue, UpdateSourceTrigger=LostFocus}" Width="160" />
                </DockPanel>
                <StackPanel Orientation="Horizontal" Spacing="20">
                  <RadioButton Content="Fixed" IsChecked="{Binding DecenterXState.IsFixed}" GroupName="CbDecX" />
                  <RadioButton Content="Variable" IsChecked="{Binding DecenterXState.IsVariable}" GroupName="CbDecX" />
                  <RadioButton Content="Pickup" IsChecked="{Binding DecenterXState.IsPickupSelected}" GroupName="CbDecX" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding DecenterXState.IsPickup}">
                  <TextBlock Text="Source Surf:" VerticalAlignment="Center" />
                  <ComboBox ItemsSource="{Binding DecenterXState.AvailablePickupSurfaces}" SelectedItem="{Binding DecenterXState.PickupSourceSurface}" Width="70" />
                  <TextBlock Text="Scale:" VerticalAlignment="Center" />
                  <TextBox Text="{Binding DecenterXState.PickupScale, UpdateSourceTrigger=LostFocus}" Width="70" />
                  <TextBlock Text="Offset:" VerticalAlignment="Center" />
                  <TextBox Text="{Binding DecenterXState.PickupOffset, UpdateSourceTrigger=LostFocus}" Width="70" />
                </StackPanel>
              </StackPanel>
            </Border>

            <!-- Decenter Y -->
            <Border BorderBrush="#CCC" BorderThickness="1" CornerRadius="4" Padding="12,8">
              <StackPanel Spacing="6">
                <DockPanel>
                  <TextBlock Text="Decenter Y (mm):" Width="130" VerticalAlignment="Center" />
                  <TextBox Text="{Binding DecenterYValue, UpdateSourceTrigger=LostFocus}" Width="160" />
                </DockPanel>
                <StackPanel Orientation="Horizontal" Spacing="20">
                  <RadioButton Content="Fixed" IsChecked="{Binding DecenterYState.IsFixed}" GroupName="CbDecY" />
                  <RadioButton Content="Variable" IsChecked="{Binding DecenterYState.IsVariable}" GroupName="CbDecY" />
                  <RadioButton Content="Pickup" IsChecked="{Binding DecenterYState.IsPickupSelected}" GroupName="CbDecY" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding DecenterYState.IsPickup}">
                  <TextBlock Text="Source Surf:" VerticalAlignment="Center" />
                  <ComboBox ItemsSource="{Binding DecenterYState.AvailablePickupSurfaces}" SelectedItem="{Binding DecenterYState.PickupSourceSurface}" Width="70" />
                  <TextBlock Text="Scale:" VerticalAlignment="Center" />
                  <TextBox Text="{Binding DecenterYState.PickupScale, UpdateSourceTrigger=LostFocus}" Width="70" />
                  <TextBlock Text="Offset:" VerticalAlignment="Center" />
                  <TextBox Text="{Binding DecenterYState.PickupOffset, UpdateSourceTrigger=LostFocus}" Width="70" />
                </StackPanel>
              </StackPanel>
            </Border>

            <!-- Tilt X -->
            <Border BorderBrush="#CCC" BorderThickness="1" CornerRadius="4" Padding="12,8">
              <StackPanel Spacing="6">
                <DockPanel>
                  <TextBlock Text="Tilt X (deg):" Width="130" VerticalAlignment="Center" />
                  <TextBox Text="{Binding TiltXValue, UpdateSourceTrigger=LostFocus}" Width="160" />
                </DockPanel>
                <StackPanel Orientation="Horizontal" Spacing="20">
                  <RadioButton Content="Fixed" IsChecked="{Binding TiltXState.IsFixed}" GroupName="CbTiltX" />
                  <RadioButton Content="Variable" IsChecked="{Binding TiltXState.IsVariable}" GroupName="CbTiltX" />
                  <RadioButton Content="Pickup" IsChecked="{Binding TiltXState.IsPickupSelected}" GroupName="CbTiltX" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding TiltXState.IsPickup}">
                  <TextBlock Text="Source Surf:" VerticalAlignment="Center" />
                  <ComboBox ItemsSource="{Binding TiltXState.AvailablePickupSurfaces}" SelectedItem="{Binding TiltXState.PickupSourceSurface}" Width="70" />
                  <TextBlock Text="Scale:" VerticalAlignment="Center" />
                  <TextBox Text="{Binding TiltXState.PickupScale, UpdateSourceTrigger=LostFocus}" Width="70" />
                  <TextBlock Text="Offset:" VerticalAlignment="Center" />
                  <TextBox Text="{Binding TiltXState.PickupOffset, UpdateSourceTrigger=LostFocus}" Width="70" />
                </StackPanel>
              </StackPanel>
            </Border>

            <!-- Tilt Y -->
            <Border BorderBrush="#CCC" BorderThickness="1" CornerRadius="4" Padding="12,8">
              <StackPanel Spacing="6">
                <DockPanel>
                  <TextBlock Text="Tilt Y (deg):" Width="130" VerticalAlignment="Center" />
                  <TextBox Text="{Binding TiltYValue, UpdateSourceTrigger=LostFocus}" Width="160" />
                </DockPanel>
                <StackPanel Orientation="Horizontal" Spacing="20">
                  <RadioButton Content="Fixed" IsChecked="{Binding TiltYState.IsFixed}" GroupName="CbTiltY" />
                  <RadioButton Content="Variable" IsChecked="{Binding TiltYState.IsVariable}" GroupName="CbTiltY" />
                  <RadioButton Content="Pickup" IsChecked="{Binding TiltYState.IsPickupSelected}" GroupName="CbTiltY" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding TiltYState.IsPickup}">
                  <TextBlock Text="Source Surf:" VerticalAlignment="Center" />
                  <ComboBox ItemsSource="{Binding TiltYState.AvailablePickupSurfaces}" SelectedItem="{Binding TiltYState.PickupSourceSurface}" Width="70" />
                  <TextBlock Text="Scale:" VerticalAlignment="Center" />
                  <TextBox Text="{Binding TiltYState.PickupScale, UpdateSourceTrigger=LostFocus}" Width="70" />
                  <TextBlock Text="Offset:" VerticalAlignment="Center" />
                  <TextBox Text="{Binding TiltYState.PickupOffset, UpdateSourceTrigger=LostFocus}" Width="70" />
                </StackPanel>
              </StackPanel>
            </Border>

            <!-- Tilt Z -->
            <Border BorderBrush="#CCC" BorderThickness="1" CornerRadius="4" Padding="12,8">
              <StackPanel Spacing="6">
                <DockPanel>
                  <TextBlock Text="Tilt Z (deg):" Width="130" VerticalAlignment="Center" />
                  <TextBox Text="{Binding TiltZValue, UpdateSourceTrigger=LostFocus}" Width="160" />
                </DockPanel>
                <StackPanel Orientation="Horizontal" Spacing="20">
                  <RadioButton Content="Fixed" IsChecked="{Binding TiltZState.IsFixed}" GroupName="CbTiltZ" />
                  <RadioButton Content="Variable" IsChecked="{Binding TiltZState.IsVariable}" GroupName="CbTiltZ" />
                  <RadioButton Content="Pickup" IsChecked="{Binding TiltZState.IsPickupSelected}" GroupName="CbTiltZ" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding TiltZState.IsPickup}">
                  <TextBlock Text="Source Surf:" VerticalAlignment="Center" />
                  <ComboBox ItemsSource="{Binding TiltZState.AvailablePickupSurfaces}" SelectedItem="{Binding TiltZState.PickupSourceSurface}" Width="70" />
                  <TextBlock Text="Scale:" VerticalAlignment="Center" />
                  <TextBox Text="{Binding TiltZState.PickupScale, UpdateSourceTrigger=LostFocus}" Width="70" />
                  <TextBlock Text="Offset:" VerticalAlignment="Center" />
                  <TextBox Text="{Binding TiltZState.PickupOffset, UpdateSourceTrigger=LostFocus}" Width="70" />
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ═══ ABCD Tab (base ray-transfer-matrix surface) ═══ -->
      <TabItem Header="ABCD" IsVisible="{Binding IsAbcd}">
        <ScrollViewer>
          <StackPanel Margin="12" Spacing="12">
            <TextBlock Text="ABCD ray-transfer matrix — [x'; w'] = [[A,B],[C,D]]·[x; w] on ray height x and slope w (same in y). Phase analyses (OPD, MTF, Zernike) are unavailable while an ABCD surface is present."
                       TextWrapping="Wrap" FontSize="12" Foreground="#666" />

            <!-- A -->
            <Border BorderBrush="#CCC" BorderThickness="1" CornerRadius="4" Padding="12,8">
              <StackPanel Spacing="6">
                <DockPanel>
                  <TextBlock Text="A:" Width="130" VerticalAlignment="Center" />
                  <TextBox Text="{Binding AValue, UpdateSourceTrigger=LostFocus}" Width="160" />
                </DockPanel>
                <StackPanel Orientation="Horizontal" Spacing="20">
                  <RadioButton Content="Fixed" IsChecked="{Binding AState.IsFixed}" GroupName="AbcdA" />
                  <RadioButton Content="Variable" IsChecked="{Binding AState.IsVariable}" GroupName="AbcdA" />
                  <RadioButton Content="Pickup" IsChecked="{Binding AState.IsPickupSelected}" GroupName="AbcdA" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding AState.IsPickup}">
                  <TextBlock Text="Source Surf:" VerticalAlignment="Center" />
                  <ComboBox ItemsSource="{Binding AState.AvailablePickupSurfaces}" SelectedItem="{Binding AState.PickupSourceSurface}" Width="70" />
                  <TextBlock Text="Scale:" VerticalAlignment="Center" />
                  <TextBox Text="{Binding AState.PickupScale, UpdateSourceTrigger=LostFocus}" Width="70" />
                  <TextBlock Text="Offset:" VerticalAlignment="Center" />
                  <TextBox Text="{Binding AState.PickupOffset, UpdateSourceTrigger=LostFocus}" Width="70" />
                </StackPanel>
              </StackPanel>
            </Border>

            <!-- B -->
            <Border BorderBrush="#CCC" BorderThickness="1" CornerRadius="4" Padding="12,8">
              <StackPanel Spacing="6">
                <DockPanel>
                  <TextBlock Text="B:" Width="130" VerticalAlignment="Center" />
                  <TextBox Text="{Binding BValue, UpdateSourceTrigger=LostFocus}" Width="160" />
                </DockPanel>
                <StackPanel Orientation="Horizontal" Spacing="20">
                  <RadioButton Content="Fixed" IsChecked="{Binding BState.IsFixed}" GroupName="AbcdB" />
                  <RadioButton Content="Variable" IsChecked="{Binding BState.IsVariable}" GroupName="AbcdB" />
                  <RadioButton Content="Pickup" IsChecked="{Binding BState.IsPickupSelected}" GroupName="AbcdB" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding BState.IsPickup}">
                  <TextBlock Text="Source Surf:" VerticalAlignment="Center" />
                  <ComboBox ItemsSource="{Binding BState.AvailablePickupSurfaces}" SelectedItem="{Binding BState.PickupSourceSurface}" Width="70" />
                  <TextBlock Text="Scale:" VerticalAlignment="Center" />
                  <TextBox Text="{Binding BState.PickupScale, UpdateSourceTrigger=LostFocus}" Width="70" />
                  <TextBlock Text="Offset:" VerticalAlignment="Center" />
                  <TextBox Text="{Binding BState.PickupOffset, UpdateSourceTrigger=LostFocus}" Width="70" />
                </StackPanel>
              </StackPanel>
            </Border>

            <!-- C -->
            <Border BorderBrush="#CCC" BorderThickness="1" CornerRadius="4" Padding="12,8">
              <StackPanel Spacing="6">
                <DockPanel>
                  <TextBlock Text="C:" Width="130" VerticalAlignment="Center" />
                  <TextBox Text="{Binding CValue, UpdateSourceTrigger=LostFocus}" Width="160" />
                </DockPanel>
                <StackPanel Orientation="Horizontal" Spacing="20">
                  <RadioButton Content="Fixed" IsChecked="{Binding CState.IsFixed}" GroupName="AbcdC" />
                  <RadioButton Content="Variable" IsChecked="{Binding CState.IsVariable}" GroupName="AbcdC" />
                  <RadioButton Content="Pickup" IsChecked="{Binding CState.IsPickupSelected}" GroupName="AbcdC" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding CState.IsPickup}">
                  <TextBlock Text="Source Surf:" VerticalAlignment="Center" />
                  <ComboBox ItemsSource="{Binding CState.AvailablePickupSurfaces}" SelectedItem="{Binding CState.PickupSourceSurface}" Width="70" />
                  <TextBlock Text="Scale:" VerticalAlignment="Center" />
                  <TextBox Text="{Binding CState.PickupScale, UpdateSourceTrigger=LostFocus}" Width="70" />
                  <TextBlock Text="Offset:" VerticalAlignment="Center" />
                  <TextBox Text="{Binding CState.PickupOffset, UpdateSourceTrigger=LostFocus}" Width="70" />
                </StackPanel>
              </StackPanel>
            </Border>

            <!-- D -->
            <Border BorderBrush="#CCC" BorderThickness="1" CornerRadius="4" Padding="12,8">
              <StackPanel Spacing="6">
                <DockPanel>
                  <TextBlock Text="D:" Width="130" VerticalAlignment="Center" />
                  <TextBox Text="{Binding DValue, UpdateSourceTrigger=LostFocus}" Width="160" />
                </DockPanel>
                <StackPanel Orientation="Horizontal" Spacing="20">
                  <RadioButton Content="Fixed" IsChecked="{Binding DState.IsFixed}" GroupName="AbcdD" />
                  <RadioButton Content="Variable" IsChecked="{Binding DState.IsVariable}" GroupName="AbcdD" />
                  <RadioButton Content="Pickup" IsChecked="{Binding DState.IsPickupSelected}" GroupName="AbcdD" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding DState.IsPickup}">
                  <TextBlock Text="Source Surf:" VerticalAlignment="Center" />
                  <ComboBox ItemsSource="{Binding DState.AvailablePickupSurfaces}" SelectedItem="{Binding DState.PickupSourceSurface}" Width="70" />
                  <TextBlock Text="Scale:" VerticalAlignment="Center" />
                  <TextBox Text="{Binding DState.PickupScale, UpdateSourceTrigger=LostFocus}" Width="70" />
                  <TextBlock Text="Offset:" VerticalAlignment="Center" />
                  <TextBox Text="{Binding DState.PickupOffset, UpdateSourceTrigger=LostFocus}" Width="70" />
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
