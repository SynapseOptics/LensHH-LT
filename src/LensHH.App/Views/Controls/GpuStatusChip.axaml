<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LensHH.App.Views.Controls.GpuStatusChip">
  <Border x:Name="Chip" CornerRadius="9" Padding="8,2,10,2"
          Background="#F0F0F0" BorderBrush="#CCCCCC" BorderThickness="1"
          VerticalAlignment="Center">
    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
      <TextBlock x:Name="Icon" Text="⚡" FontSize="12" Foreground="#AAAAAA" VerticalAlignment="Center" />
      <TextBlock x:Name="Label" Text="GPU" FontSize="12" Foreground="#777777" VerticalAlignment="Center" />
    </StackPanel>
  </Border>
</UserControl>
