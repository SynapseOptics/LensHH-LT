<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LensHH.App.ViewModels"
        x:Class="LensHH.App.Views.SystemEditorDialog"
        x:DataType="vm:SystemEditorViewModel"
        Title="System Editor"
        Icon="avares://LensHH.App/Assets/icon_256.png"
        Width="370" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

  <StackPanel Margin="16" Spacing="12">
    <!-- Title -->
    <DockPanel>
      <TextBlock Text="Title:" Width="120" VerticalAlignment="Center" />
      <TextBox Text="{Binding Title, UpdateSourceTrigger=LostFocus}" HorizontalAlignment="Stretch" />
    </DockPanel>

    <!-- Aperture Type -->
    <DockPanel>
      <TextBlock Text="Aperture Type:" Width="120" VerticalAlignment="Center" />
      <ComboBox ItemsSource="{Binding ApertureTypes}"
                SelectedItem="{Binding ApertureType}"
                HorizontalAlignment="Stretch" />
    </DockPanel>

    <!-- Aperture Value -->
    <DockPanel>
      <TextBlock Text="Aperture Value:" Width="120" VerticalAlignment="Center" />
      <!-- Disabled when a host reports the aperture value as varied-across-configs (advanced edition);
           always enabled in the standard build (IsApertureOwned is always false). -->
      <TextBox Text="{Binding ApertureValue, UpdateSourceTrigger=LostFocus}" HorizontalAlignment="Stretch"
               IsEnabled="{Binding !IsApertureOwned}" />
    </DockPanel>

    <!-- Field Type -->
    <DockPanel>
      <TextBlock Text="Field Type:" Width="120" VerticalAlignment="Center" />
      <ComboBox ItemsSource="{Binding FieldTypes}"
                SelectedItem="{Binding FieldType}"
                HorizontalAlignment="Stretch" />
    </DockPanel>

    <!-- Validation message (inline, no button needed) -->
    <TextBlock Text="{Binding ValidationMessage}"
               Foreground="Red" FontSize="12" TextWrapping="Wrap"
               IsVisible="{Binding ValidationMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

    <!-- Afocal -->
    <CheckBox Content="Afocal" IsChecked="{Binding IsAfocal}" />

    <!-- Telecentric Object Space (only for the Object Space NA aperture) -->
    <CheckBox Content="Telecentric Object Space"
              IsChecked="{Binding TelecentricObjectSpace}"
              IsEnabled="{Binding IsTelecentricEnabled}"
              ToolTip.Tip="Object-space telecentric: entrance pupil at infinity (chief ray parallel to the axis in object space). Requires the Object Space NA aperture." />

    <!-- Penalize Vignetting -->
    <CheckBox Content="Penalize Vignetting"
              IsChecked="{Binding PenalizeVignetting}"
              ToolTip.Tip="When on, every vignetted (clipped) ray — off-axis included — incurs a stiff per-ray penalty during optimization. Use for stock-lens designs where catalog apertures must not be exceeded." />

    <!-- Use Automatic Vignetting Factors -->
    <CheckBox Content="Use Automatic Vignetting Factors"
              IsChecked="{Binding UseAutomaticVignettingFactors}"
              ToolTip.Tip="When on, per-field vignetting factors are computed automatically (after the semi-diameter solve) and applied as an entrance-pupil remap — a fast, differentiable substitute for hard aperture clipping. Optimization runs on the C# engine while this is enabled." />

    <!-- Ray Aiming -->
    <CheckBox Content="Real Ray Aiming" IsChecked="{Binding RayAiming}" />
    <CheckBox Content="Robust Ray Aiming (wide angle)" IsChecked="{Binding RobustRayAiming}"
              IsEnabled="{Binding RayAiming}" Margin="20,0,0,0" />

    <!-- Semi-diameter solve (how Auto diameters are derived) -->
    <DockPanel>
      <TextBlock Text="Auto Diameters:" Width="120" VerticalAlignment="Center" />
      <ComboBox ItemsSource="{Binding SemiDiameterSolveModes}"
                SelectedItem="{Binding SemiDiameterSolve}"
                HorizontalAlignment="Stretch"
                ToolTip.Tip="How Auto semi-diameters are derived. Real Ray sizes each surface to whichever real rays survive — the historical behaviour. Paraxial sizes it to the beam the design actually needs (marginal + chief height), with no ray tracing, so nothing can fail or be vignetted. Paraxial suits fast screening, and it also keeps edge-thickness and semi-diameter constraints meaningful on a design that has stopped passing light: with Real Ray the apertures shrink to fit the surviving rays, which quietly satisfies those constraints instead of violating them. Surfaces set to Fixed are unaffected. Changing this will move ET/EA/EG/SD values on an existing design." />
    </DockPanel>

    <!-- Bound Handling (optimizer variable bounds) -->
    <DockPanel>
      <TextBlock Text="Bound Handling:" Width="120" VerticalAlignment="Center" />
      <ComboBox ItemsSource="{Binding BoundHandlingModes}"
                SelectedItem="{Binding BoundHandling}"
                HorizontalAlignment="Stretch"
                ToolTip.Tip="How bounded optimization variables (those with a Min and/or Max) are mapped into the optimizer&apos;s search space. Sigmoid is the historical default: smooth, but its gradient vanishes at a bound, so a variable pushed to a limit stops responding. Reflect keeps the variable in physical units and folds out-of-range values back inside, so the gradient never collapses at the bounds — usually better for constrained and stochastic search." />
    </DockPanel>

    <!-- Buttons -->
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
      <Button Content="OK" Click="OK_Click" Width="80" />
      <Button Content="Cancel" Click="Cancel_Click" Width="80" IsCancel="True" />
    </StackPanel>
  </StackPanel>
</Window>
