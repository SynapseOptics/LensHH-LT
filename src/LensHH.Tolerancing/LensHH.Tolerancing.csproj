<Project Sdk="Microsoft.NET.Sdk">

  <!-- Tolerancing: sensitivity and Monte Carlo of a lens's manufacturing errors, traced by the
       LensHH engine. Ported from the MIT-licensed TolerancingModule. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>LensHH.Tolerancing</RootNamespace>
    <AssemblyName>LensHH.Tolerancing</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="LensHH.Core">
      <HintPath Condition="'$(LensHHEngineDll)' != ''">$(LensHHEngineDll)</HintPath>
      <HintPath Condition="'$(LensHHEngineDll)' == ''">$(MSBuildThisFileDirectory)..\..\engine\LensHH.Core.dll</HintPath>
    </Reference>
    <ProjectReference Include="..\LensHH.IO\LensHH.IO.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LensHH.Tolerancing.Tests" />
  </ItemGroup>

  <!-- The native library the engine's paraxial values route through; .NET loads the one for this OS. -->
  <ItemGroup>
    <None Include="..\..\engine\win-x64\lenshh_native.dll"
          CopyToOutputDirectory="PreserveNewest"
          Link="lenshh_native.dll"
          Condition="Exists('..\..\engine\win-x64\lenshh_native.dll')" />
    <None Include="..\..\engine\osx-arm64\liblenshh_native.dylib"
          CopyToOutputDirectory="PreserveNewest"
          Link="liblenshh_native.dylib"
          Condition="Exists('..\..\engine\osx-arm64\liblenshh_native.dylib')" />
    <None Include="..\..\engine\linux-x64\liblenshh_native.so"
          CopyToOutputDirectory="PreserveNewest"
          Link="liblenshh_native.so"
          Condition="Exists('..\..\engine\linux-x64\liblenshh_native.so')" />
  </ItemGroup>

</Project>
